# ===========================================
# SUPABASE (CLOUD)
# Nota: el CLI no permite prefijo SUPABASE_. Usamos SB_*
# ===========================================
SB_URL=https://<tu-project-ref>.supabase.co
SB_SERVICE_ROLE_KEY=<tu_service_role_key>

# ===========================================
# WOOCOMMERCE (WORDPRESS)
# ===========================================
WOOCOMMERCE_STORE_URL=https://tu-tienda.com
WOOCOMMERCE_CONSUMER_KEY=ck_tu_consumer_key
# WooCommerce es sensible a mayúsculas/minúsculas; usa consumer secret válido.
WOOCOMMERCE_CONSUMER_SECRET=cs_tu_consumer_secret

# ===========================================
# HOLDED (FACTURACIÓN)
# ===========================================
HOLDED_API_KEY=<tu_holded_api_key>

# ===========================================
# TWILIO (SMS / WHATSAPP)
# ===========================================
TWILIO_ACCOUNT_SID=<opcional>
TWILIO_AUTH_TOKEN=<opcional>
TWILIO_PHONE_NUMBER=<opcional>
TWILIO_WHATSAPP_NUMBER=<opcional>

# ===========================================
# RESEND (EMAIL)
# ===========================================
RESEND_API_KEY=<opcional>
FROM_EMAIL=notificaciones@tudominio.com

